# ─── Copy this file to .env and fill in your real values ───────────────────
# The backend reads these at startup. None of these services are created
# by this project – you must start MySQL, Memcached and RabbitMQ yourself.

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=vineeth_user
MYSQL_PASSWORD=your_password_here
MYSQL_DB=vineeth_portfolio

# Memcached  (default port 11211)
MEMCACHED_HOST=localhost
MEMCACHED_PORT=11211

# RabbitMQ   (default port 5672)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Flask
FLASK_PORT=5000
FLASK_DEBUG=false
